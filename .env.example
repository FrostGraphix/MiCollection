# =========================================================================
# MiCollections - Production Environment Configuration
# =========================================================================

# Site URL (for Paystack callback & Auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------------------
# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (used server-side only for webhook order fulfillment)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------------------------------------
# Paystack Payment Gateway
# Found in: Paystack Dashboard -> Settings -> API Keys & Webhooks
# -------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# -------------------------------------------------------------------------
# WhatsApp Business Support Details
# -------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_PHONE=2348145736483
NEXT_PUBLIC_WHATSAPP_DISPLAY=+234 814 573 6483
NEXT_PUBLIC_SUPPORT_EMAIL=support@micollections.com

# -------------------------------------------------------------------------
# Bank Transfer Payment Details
# -------------------------------------------------------------------------
NEXT_PUBLIC_BANK_NAME=Zenith Bank
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=1012345678
NEXT_PUBLIC_BANK_ACCOUNT_NAME=MiCollections Ltd

# -------------------------------------------------------------------------
# Administrative Staff Identity & Roles
# -------------------------------------------------------------------------
STAFF_EMAILS=admin@micollections.com,manager@micollections.com,dispatch@micollections.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@micollections.com
NEXT_PUBLIC_ADMIN_NAME=Mariam Siyaka
NEXT_PUBLIC_MANAGER_EMAIL=manager@micollections.com
NEXT_PUBLIC_MANAGER_NAME=Aminu Bello
NEXT_PUBLIC_DISPATCH_EMAIL=dispatch@micollections.com
NEXT_PUBLIC_DISPATCH_NAME=Chidi Okafor

# -------------------------------------------------------------------------
# Internal Security Secrets (Server-side only)
# -------------------------------------------------------------------------
INTERNAL_API_SECRET=your-internal-service-secret-token
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password
